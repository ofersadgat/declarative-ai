{
  "name": "@declarative-ai/hw",
  "version": "0.1.0",
  "description": "The hierarchical-workflow formalism: expression language, state-file loader and validator, snapshot hashing, evaluator engine, and its executor.",
  "keywords": [
    "declarative-ai",
    "workflow",
    "state-machine",
    "orchestration",
    "ai"
  ],
  "author": "Ofer Sadgat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ofersadgat/declarative-ai.git",
    "directory": "packages/hw"
  },
  "homepage": "https://github.com/ofersadgat/declarative-ai/tree/main/packages/hw#readme",
  "bugs": {
    "url": "https://github.com/ofersadgat/declarative-ai/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json"
  },
  "dependencies": {
    "@declarative-ai/exec": "^0.1.0",
    "@declarative-ai/json": "^0.1.0",
    "@declarative-ai/ops": "^0.1.0",
    "@declarative-ai/permissions": "^0.1.0",
    "@declarative-ai/validate": "^0.1.0",
    "yaml": "^2.9.0"
