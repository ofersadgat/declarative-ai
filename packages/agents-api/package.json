{
  "name": "@declarative-ai/agents-api",
  "version": "0.1.0",
  "description": "Delegated agents reached through an in-process SDK, over the normalized AgentQuery seam shared with @declarative-ai/agents-cli.",
  "keywords": [
    "declarative-ai",
    "agents",
    "claude-code",
    "delegation",
    "ai"
  ],
  "author": "Ofer Sadgat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ofersadgat/declarative-ai.git",
    "directory": "packages/agents-api"
  },
  "homepage": "https://github.com/ofersadgat/declarative-ai/tree/main/packages/agents-api#readme",
  "bugs": {
    "url": "https://github.com/ofersadgat/declarative-ai/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json"
  },
  "dependencies": {
    "@declarative-ai/exec": "^0.1.0",
    "@declarative-ai/json": "^0.1.0",
    "@declarative-ai/llm": "^0.1.0",
    "@declarative-ai/ops": "^0.1.0",
    "@declarative-ai/permissions": "^0.1.0",
    "@declarative-ai/promptop": "^0.1.0"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": "*",
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    },
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  }
}
