{
  "name": "@declarative-ai/tools",
  "version": "0.1.0",
  "description": "Workspace-backed agent tools - read_file, write_file, edit_file, list_dir, grep, glob, run_command - with a path-escape guard.",
  "keywords": [
    "declarative-ai",
    "agent-tools",
    "filesystem",
    "shell",
    "coding-agent"
  ],
  "author": "Ofer Sadgat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ofersadgat/declarative-ai.git",
    "directory": "packages/tools"
  },
  "homepage": "https://github.com/ofersadgat/declarative-ai/tree/main/packages/tools#readme",
  "bugs": {
    "url": "https://github.com/ofersadgat/declarative-ai/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json"
  },
  "dependencies": {
    "@declarative-ai/exec": "^0.1.0",
    "@declarative-ai/json": "^0.1.0"
  }
}
